1 ICON "assets/toaster.ico"
1 24 "assets/gametoaster.manifest"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "GameToaster game launcher"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "InternalName", "GameToaster"
      VALUE "OriginalFilename", "GameToaster.exe"
      VALUE "ProductName", "GameToaster"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
